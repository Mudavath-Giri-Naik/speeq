# ─────────────────────────────────────────────────────────────────────────────
# speeq — example environment. Copy the parts you need into apps/*/.env.local.
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Demo app (apps/demo) ─────────────────────────────────────────────────────
# Signs session tokens. Required in production. Generate with: openssl rand -hex 32
SPEEQ_SECRET=
# Optional free LLM keys. With neither set, the demo runs in "mock mode".
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Which provider to prefer if both keys are set: groq | gemini | mock
SPEEQ_LLM=gemini
# Password for the demo admin (audit viewer). Defaults to "admin" in development only.
DEMO_ADMIN_PASSWORD=
# Telemetry: point at your platform (local: http://localhost:3001) and paste a project key.
SPEEQ_PLATFORM_URL=
SPEEQ_PROJECT_KEY=
# Set to 0 to disable telemetry completely.
SPEEQ_TELEMETRY=

# ── Platform app (apps/platform) ─────────────────────────────────────────────
# Postgres for the platform (Supabase free tier, or any Postgres). Leave both empty to use an
# embedded local PGlite database. Supabase: Project → Connect → "ORMs"/connection strings.
# Runtime URL: the Transaction pooler (port 6543). The app disables prepared statements for it.
DATABASE_URL=
# Migrations URL: the Session pooler (port 5432). Falls back to DATABASE_URL when empty.
DATABASE_URL_DIRECT=
# Dashboard login.
ADMIN_PASSWORD=
# Signs the admin session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Protects the daily cleanup cron route (Vercel sends it as a Bearer token).
CRON_SECRET=
# owner/repo for the stars/forks card.
GITHUB_REPO=Mudavath-Giri-Naik/speeq
