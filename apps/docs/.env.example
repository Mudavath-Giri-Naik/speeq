# Public address of the site, for links, the sitemap and social images.
NEXT_PUBLIC_SITE_URL=
# Optional. A token with no scopes, to raise the GitHub rate limit for the stats page. Server only.
GITHUB_TOKEN=
# Assistant. With no key, a small offline guide answers.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional. Gemini model to try first. If it fails or is slow, the site falls back to
# gemini-3.1-flash-lite, gemini-3.5-flash-lite and gemini-2.5-flash, then to the offline guide.
# Leave it empty unless you know a model that answers fast for you.
GEMINI_MODEL=
SPEEQ_SECRET=
