{
  "name": "@speeq/platform",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "predev": "turbo run build --filter=@speeq/core",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "seed:clear": "tsx scripts/seed-clear.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@next/env": "16.4.6",
    "@speeq/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.18",
    "next": "16.4.6",
    "postgres": "3.4.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@speeq/server": "workspace:*",
    "@speeq/store-memory": "workspace:*",
    "@speeq/testing": "workspace:*",
    "@speeq/tsconfig": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
