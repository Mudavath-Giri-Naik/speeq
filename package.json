{
  "name": "speeq-monorepo",
  "private": true,
  "description": "speeq — open-source, headless conversational-AI framework for web apps.",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@speeq/demo --filter=@speeq/platform",
    "dev:docs": "turbo run dev --filter=@speeq/docs",
    "lint": "biome check . && tsx scripts/check-deps-direction.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "test": "turbo run test && vitest run --config scripts/vitest.config.ts",
    "test:e2e": "turbo run test:e2e --filter=@speeq/demo",
    "check-deps": "tsx scripts/check-deps-direction.ts",
    "pack-all": "bash scripts/pack-all.sh",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-cli-version.mjs",
    "release": "pnpm build && changeset publish --tag next"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.6",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
