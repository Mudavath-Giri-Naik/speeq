{
  "name": "@speeq/compiler",
  "version": "0.4.0",
  "description": "Read-only discovery of what a Next.js app can expose to a speeq agent.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mudavath-Giri-Naik/speeq.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/Mudavath-Giri-Naik/speeq#readme",
  "keywords": [
    "speeq",
    "nextjs",
    "cli",
    "conversational-ai"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "@speeq/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "node --conditions=@speeq/source --import tsx src/eval/report.ts",
    "bench": "node --conditions=@speeq/source --import tsx scripts/gen-large-fixture.ts"
  },
  "dependencies": {
    "@speeq/core": "workspace:*",
    "typescript": "6.0.3",
    "ignore": "7.0.17"
  },
  "devDependencies": {
    "@speeq/tsconfig": "workspace:*",
    "tsx": "4.23.15"
  }
}
