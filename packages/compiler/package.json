{
  "type": "module",
  "exports": {
    ".": {
      "@speeq/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "node --conditions=@speeq/source --import tsx src/eval/report.ts"
  },
  "dependencies": {
    "@speeq/core": "workspace:*",
    "typescript": "6.0.3",
    "ignore": "7.0.17"
  },
  "name": "@speeq/compiler",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@speeq/tsconfig": "workspace:*",
    "tsx": "4.23.15"
  }
}
