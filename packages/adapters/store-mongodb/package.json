{
  "name": "@speeq/store-mongodb",
  "version": "0.8.0",
  "description": "MongoDB ConversationStore for speeq that reuses your existing Db connection.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mudavath-Giri-Naik/speeq.git",
    "directory": "packages/adapters/store-mongodb"
  },
  "homepage": "https://github.com/Mudavath-Giri-Naik/speeq#readme",
  "keywords": [
    "speeq",
    "voice",
    "agent",
    "conversational-ai",
    "headless"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@speeq/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@speeq/core": "workspace:*"
  },
  "peerDependencies": {
    "mongodb": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@speeq/tsconfig": "workspace:*",
    "@speeq/testing": "workspace:*",
    "mongodb": "7.9.1",
    "mongodb-memory-server": "11.4.0",
    "zod": "4.6.7"
  }
}
