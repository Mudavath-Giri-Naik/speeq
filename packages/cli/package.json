{
  "name": "@speeq/cli",
  "version": "0.5.0",
  "description": "The speeq command: init, scan, verify, doctor, rollback.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mudavath-Giri-Naik/speeq.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Mudavath-Giri-Naik/speeq#readme",
  "keywords": [
    "speeq",
    "nextjs",
    "cli",
    "conversational-ai"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "speeq": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "@speeq/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:real": "node --conditions=@speeq/source --import tsx scripts/validate-real-apps.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "@speeq/compiler": "workspace:*",
    "@speeq/core": "workspace:*",
    "@speeq/integrate": "workspace:*",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@speeq/tsconfig": "workspace:*",
    "tsx": "4.23.15"
  }
}
