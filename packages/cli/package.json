{
  "name": "@speeq/cli",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "bin": { "speeq": "./dist/bin.js" },
  "exports": {
    ".": {
      "@speeq/source": "./src/index.ts",
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    },
    "./package.json": "./package.json"
  },
  "scripts": { "build": "tsup", "typecheck": "tsc --noEmit", "test": "vitest run" },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "@speeq/compiler": "workspace:*",
    "@speeq/core": "workspace:*",
    "@speeq/integrate": "workspace:*",
    "picocolors": "1.1.1"
  },
  "devDependencies": { "@speeq/tsconfig": "workspace:*", "tsx": "4.23.15" }
}
