{
  "name": "@speeq/integrate",
  "version": "0.12.0",
  "description": "Plans, applies and rolls back speeq integration in a Next.js app. Writes only files it owns.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mudavath-Giri-Naik/speeq.git",
    "directory": "packages/integrate"
  },
  "homepage": "https://github.com/Mudavath-Giri-Naik/speeq#readme",
  "keywords": [
    "speeq",
    "nextjs",
    "cli",
    "conversational-ai"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "@speeq/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@speeq/compiler": "workspace:*",
    "@speeq/core": "workspace:*",
    "@speeq/server": "workspace:*",
    "@speeq/store-memory": "workspace:*",
    "@speeq/store-mongodb": "workspace:*",
    "@speeq/testing": "workspace:*",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@speeq/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "mongodb": "7.9.1",
    "mongodb-memory-server": "11.4.0",
    "zod": "4.6.7"
  }
}
